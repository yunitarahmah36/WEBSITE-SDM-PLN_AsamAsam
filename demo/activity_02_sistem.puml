@startuml AD-02 Pendaftaran Magang - Bagian Sistem

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam activity {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    ArrowColor #1A5276
    StartColor #1A5276
    EndColor #1A5276
    BarColor #2E86C1
    FontSize 12
}
skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #D4AC0D
}

title Activity Diagram - Pendaftaran & Verifikasi Magang\nBagian 2: Alur Sistem (Proses Otomatis)\nSIAMAM - Sistem Informasi Administrasi Praktek Magang

|Mahasiswa|

start

:Klik Tombol Kirim Lamaran;

|Sistem|

:Menyimpan data lamaran\ndengan status 'Pending';

:Mengirim Notifikasi ke Admin;

note right
  Notifikasi dikirim via email
  ke Admin dan Pembimbing Lapangan
  yang mengelola divisi tersebut
end note

|Admin|

:Membuka Dashboard Admin;

|Sistem|

fork
  :Mengubah Status Lamaran\nmenjadi 'Accepted';
  :Mengurangi Kuota Tempat Magang;
fork again
  :Mengubah Status Lamaran\nmenjadi 'Rejected';
end fork

:Memperbarui Dashboard Mahasiswa;

|Mahasiswa|

:Melihat Status Lamaran Terbaru;

stop

@enduml
