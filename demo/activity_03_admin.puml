@startuml AD-03 Pendaftaran Magang - Bagian Admin

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam activity {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    ArrowColor #1A5276
    StartColor #1A5276
    EndColor #1A5276
    BarColor #2E86C1
    FontSize 12
}
skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #D4AC0D
}
skinparam decision {
    BackgroundColor #D6EAF8
    BorderColor #2E86C1
}

title Activity Diagram - Pendaftaran & Verifikasi Magang\nBagian 3: Alur Admin (Verifikasi & Keputusan)\nSIAMAM - Sistem Informasi Administrasi Praktek Magang

|Sistem|

start

:Mengirim Notifikasi ke Admin;

|Admin|

:Membuka Dashboard Admin;

:Masuk ke Menu Kelola Data Mahasiswa / Lamaran;

:Memeriksa Berkas & Persyaratan Mahasiswa;

if (Apakah Berkas Layak\n& Kuota Tersedia?) then (Ya)
    :Klik Tombol 'Setujui';
    |Sistem|
    :Mengubah Status Lamaran\nmenjadi 'Accepted';
    :Mengurangi Kuota Tempat Magang;
else (Tidak)
    |Admin|
    :Klik Tombol 'Tolak';
    :Memasukkan Catatan Penolakan;
    |Sistem|
    :Mengubah Status Lamaran\nmenjadi 'Rejected';
endif

:Memperbarui Dashboard Mahasiswa;

stop

@enduml
